# Solana RPC URL the frontend talks to. The cluster is auto-detected from the
# URL (localhost → localnet, *devnet* → devnet, *testnet* → testnet, anything
# else → mainnet). When unset, defaults to https://api.mainnet-beta.solana.com.
#
# Local validator example:
# VITE_SOLANA_RPC_URL=http://localhost:8899
#
# Devnet example:
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
